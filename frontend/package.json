{
  "name": "papers-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "dev:demo": "vite --mode demo",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p e2e --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsc -p e2e && playwright test"
  },
  "dependencies": {
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-bold": "3.35.0",
    "@tiptap/extension-code": "3.35.0",
    "@tiptap/extension-document": "3.35.0",
    "@tiptap/extension-hard-break": "3.35.0",
    "@tiptap/extension-italic": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-paragraph": "3.35.0",
    "@tiptap/extension-strike": "3.35.0",
    "@tiptap/extension-text": "3.35.0",
    "@tiptap/extensions": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "emojibase-data": "18.0.0",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
