{
  "name": "papers-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "dev:demo": "vite --mode demo",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p e2e --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsc -p e2e && playwright test"
  },
  "dependencies": {
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-bold": "3.35.0",
    "@tiptap/extension-code": "3.35.0",
    "@tiptap/extension-document": "3.35.0",
    "@tiptap/extension-hard-break": "3.35.0",
    "@tiptap/extension-italic": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-paragraph": "3.35.0",
    "@tiptap/extension-strike": "3.35.0",
    "@tiptap/extension-text": "3.35.0",
    "@tiptap/extensions": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "emojibase-data": "18.0.0",
    "mermaid": "11.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "jsdom": "27.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.3.7",
    "vitest": "4.0.8"
  }
}
